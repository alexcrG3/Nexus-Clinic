    {
      "parameters": {
        "jsCode": "const item = $input.first().json;  // Viene del trigger con Fecha\n\nconst fechaOriginal = new Date(item.Fecha);\nif (isNaN(fechaOriginal)) {\n  throw new Error('Fecha inválida en Code: ' + item.Fecha);\n}\n\n// Sumar 1 hora\nfechaOriginal.setHours(fechaOriginal.getHours() + 1);\n\n// ISO sin zona horaria\nconst fechaFormateada = fechaOriginal\n  .toISOString()\n  .substring(0, 19);\n\nreturn [{\n  json: {\n    ...item,\n    FechaOriginal: item.Fecha,\n    FechaMasUnaHora: fechaFormateada\n  }\n}];\n"
      },
